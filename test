local RAW = "https://raw.githubusercontent.com/IlIlIlIlIlIlIlIlIlIlIIIlllIIIII/test/refs/heads/main/test"

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TeleportService = game:GetService("TeleportService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

----------------------------------------------------------------
-- WAIT FOR CHARACTER
----------------------------------------------------------------
local function waitChar()
    local c = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    repeat task.wait() until c:FindFirstChild("Humanoid")
    return c
end

local Character = waitChar()

----------------------------------------------------------------
-- START SYSTEM (ANIMATIONS + MOVEMENT)
----------------------------------------------------------------
local function StartSystem()
    local Humanoid = Character:WaitForChild("Humanoid")

    local animGojo = Instance.new("Animation")
    animGojo.AnimationId = ReplicatedStorage.Emote.GojoWalk.R15.Idle.AnimationId
    local trackGojo = Humanoid:LoadAnimation(animGojo)
    trackGojo.Looped = true
    trackGojo.Priority = Enum.AnimationPriority.Action

    local animGeto = Instance.new("Animation")
    animGeto.AnimationId = ReplicatedStorage.Emote.GetoWalk.R15.Idle.AnimationId
    local trackGeto = Humanoid:LoadAnimation(animGeto)
    trackGeto.Looped = true
    trackGeto.Priority = Enum.AnimationPriority.Action

    local toggleGojo = false
    local toggleGeto = false
    local playingGojo = false
    local playingGeto = false

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end

        if input.KeyCode == Enum.KeyCode.One then
            toggleGojo = not toggleGojo
            if not toggleGojo and playingGojo then
                trackGojo:Stop()
                playingGojo = false
            end
        end

        if input.KeyCode == Enum.KeyCode.Two then
            toggleGeto = not toggleGeto
            if not toggleGeto and playingGeto then
                trackGeto:Stop()
                playingGeto = false
            end
        end
    end)

    RunService.RenderStepped:Connect(function()
        local moving = Humanoid.MoveDirection.Magnitude > 0.1

        if toggleGojo and moving then
            if not playingGojo then
                playingGojo = true
                trackGojo:Play()
            end
            if playingGeto then
                trackGeto:Stop()
                playingGeto = false
            end

        elseif toggleGeto and moving then
            if not playingGeto then
                playingGeto = true
                trackGeto:Play()
            end
            if playingGojo then
                trackGojo:Stop()
                playingGojo = false
            end

        else
            if playingGojo then
                trackGojo:Stop()
                playingGojo = false
            end
            if playingGeto then
                trackGeto:Stop()
                playingGeto = false
            end
        end
    end)

    Humanoid.HipHeight = 2.95
end

StartSystem()

----------------------------------------------------------------
-- LAG‑FREE GUI UPDATE SYSTEM
----------------------------------------------------------------
local function updateStats()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return end

    local stats = gui:FindFirstChild("StatsScreenGui")
    if not stats or not stats.Enabled then return end -- only update when open

    local wrapper = stats:FindFirstChild("StatsWrapper")
    if not wrapper then return end

    local content = wrapper:FindFirstChild("Content")
    if not content then return end

    local right = content:FindFirstChild("RightPanel")
    if not right then return end

    local pageHost = right:FindFirstChild("PageHost")
    if not pageHost then return end

    local statsWrap = pageHost:FindFirstChild("StatsWrapper")
    if not statsWrap then return end

    local page1 = statsWrap:FindFirstChild("StatsPage1")
    if not page1 then return end

    page1.Row_Ethnicity.ValueArea_Ethnicity.Value_Ethnicity.Text = "Saiyan"
    page1.Row_Height.HeightPartsContainer.HeightFeetLeft.SplitPartContainer_Height.ValueArea_Height.Value_Height.Text = "7.0"
    page1.Row_Height.HeightPartsContainer.HeightCmRight.SplitPartContainer_Height.ValueArea_Height.Value_Height.Text = "213cm"
    right.Frame.HeaderActions.RerollHeader.RerollBalance.Text = "Rerolls: 11,984"
end

task.spawn(function()
    while true do
        task.wait(0.25) -- update 4x per second instead of 60
        updateStats()
    end
end)

