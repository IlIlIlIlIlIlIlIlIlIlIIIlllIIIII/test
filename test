----------------------------------------------------------------
-- WAIT FOR CHARACTER
----------------------------------------------------------------
local function waitChar()
    local c = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    repeat task.wait() until c:FindFirstChild("Humanoid")
    return c
end

local Character = waitChar()
local Humanoid = Character:WaitForChild("Humanoid")
Humanoid.HipHeight = 2.75

----------------------------------------------------------------
-- RESCAN GUI EVERY TIME (NEVER BREAKS)
----------------------------------------------------------------
local function getStats()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return nil end

    local statsGui = gui:FindFirstChild("StatsScreenGui")
    if not statsGui or not statsGui.Enabled then return nil end

    local wrapper = statsGui:FindFirstChild("StatsWrapper")
    if not wrapper then return nil end

    local content = wrapper:FindFirstChild("Content")
    if not content then return nil end

    local right = content:FindFirstChild("RightPanel")
    if not right then return nil end

    local pageHost = right:FindFirstChild("PageHost")
    if not pageHost then return nil end

    local statsWrap = pageHost:FindFirstChild("StatsWrapper")
    if not statsWrap then return nil end

    local page1 = statsWrap:FindFirstChild("StatsPage1")
    if not page1 then return nil end

    return page1, right
end

----------------------------------------------------------------
-- GUI UPDATE FUNCTION (ALL VALUES RESTORED)
----------------------------------------------------------------
local function updateStats()
    local page1, right = getStats()
    if not page1 then return end

    -- ETHNICITY
    page1.Row_Ethnicity.ValueArea_Ethnicity.Value_Ethnicity.Text = "Saiyan"

    -- HEIGHT (FEET)
    page1.Row_Height.HeightPartsContainer.HeightFeetLeft
        .SplitPartContainer_Height.ValueArea_Height.Value_Height.Text = "7.0"

    -- HEIGHT (CM)
    page1.Row_Height.HeightPartsContainer.HeightCmRight
        .SplitPartContainer_Height.ValueArea_Height.Value_Height.Text = "213cm"

    -- REROLLS
    right.Frame.HeaderActions.RerollHeader.RerollBalance.Text = "Rerolls: 11,984"
end

----------------------------------------------------------------
-- M KEY = TOGGLE GUI LOOP
----------------------------------------------------------------
local guiLoop = false

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.M then
        guiLoop = not guiLoop

        if guiLoop then
            task.spawn(function()
                while guiLoop do
                    updateStats()
                    task.wait(1.5)
                end
            end)
        end
    end
end)

