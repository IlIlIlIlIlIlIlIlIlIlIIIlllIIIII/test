local RAW = "https://raw.githubusercontent.com/IlIlIlIlIlIlIlIlIlIlIIIlllIIIII/test/refs/heads/main/test"

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TeleportService = game:GetService("TeleportService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

----------------------------------------------------------------
-- PERMANENT GUI SPAM (ALWAYS RUNS, EVEN AFTER TELEPORT)
----------------------------------------------------------------
task.spawn(function()
    while true do
        task.wait()

        pcall(function()
            local gui = LocalPlayer:FindFirstChild("PlayerGui")
            if not gui then return end

            local stats = gui:FindFirstChild("StatsScreenGui")
            if not stats then return end

            local wrapper = stats:FindFirstChild("StatsWrapper")
            if not wrapper then return end

            local content = wrapper:FindFirstChild("Content")
            if not content then return end

            local right = content:FindFirstChild("RightPanel")
            if not right then return end

            local pageHost = right:FindFirstChild("PageHost")
            if not pageHost then return end

            local statsWrap = pageHost:FindFirstChild("StatsWrapper")
            if not statsWrap then return end

            local page1 = statsWrap:FindFirstChild("StatsPage1")
            if not page1 then return end

            page1.Row_Ethnicity.ValueArea_Ethnicity.Value_Ethnicity.Text = "Saiyan"

            page1.Row_Height.HeightPartsContainer.HeightFeetLeft
                .SplitPartContainer_Height.ValueArea_Height.Value_Height.Text = "7.0"

            page1.Row_Height.HeightPartsContainer.HeightCmRight
                .SplitPartContainer_Height.ValueArea_Height.Value_Height.Text = "213cm"

            right.Frame.HeaderActions.RerollHeader.RerollBalance.Text = "Rerolls: 11,984"
        end)
    end
end)

----------------------------------------------------------------
-- Z = REJOIN (QUEUE RAW, THEN TELEPORT)
----------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Z then
        queue_on_teleport([[

loadstring(game:HttpGet("https://raw.githubusercontent.com/IlIlIlIlIlIlIlIlIlIlIIIlllIIIII/test/refs/heads/main/test"))()

]])
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
end)

----------------------------------------------------------------
-- X = SERVER HOP (QUEUE RAW, THEN TELEPORT TO NEW SERVER)
----------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.X then
        local servers = HttpService:JSONDecode(
            game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        )

        for _, server in ipairs(servers.data) do
            if server.playing < server.maxPlayers then
                queue_on_teleport([[

loadstring(game:HttpGet("https://raw.githubusercontent.com/IlIlIlIlIlIlIlIlIlIlIIIlllIIIII/test/refs/heads/main/test"))()

]])
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                break
            end
        end
    end
end)

